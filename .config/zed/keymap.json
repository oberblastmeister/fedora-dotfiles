[
    {
        "bindings": {
            "ctrl-\\": "pane::CloseActiveItem",
            "ctrl-q": null,
            // annoyingly conflicts with the vim keybinding
            "ctrl-o": null,
            // annoying
            "ctrl-;": null,
        }
    },
    {
      "context": "VimControl && !menu",
      "bindings": {
        "ctrl-o": "pane::GoBack",
      },
    },
    // global
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-k": "file_finder::Toggle",
            "ctrl-shift-t": "workspace::NewCenterTerminal",
            "ctrl-shift-p": "command_palette::Toggle"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-t": "workspace::ToggleBottomDock",
            "ctrl-n": "workspace::NewTerminal"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-l": "workspace::ActivatePaneRight",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-j": "workspace::ActivatePaneDown"
        }
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            // "a": "project_panel::NewFile",
            // "A": "project_panel::NewDirectory",
            // "x": "project_panel::Cut",
            // "y": "project_panel::Copy",
            // "F": "project_panel::RevealInFinder"
        }
    },
    {
        "context": "!Terminal",
        "bindings": {
            "ctrl-t": "terminal_panel::ToggleFocus"
        }
    },
    // {
    //     "context": "OutlinePanel",
    //     "bindings": {
    //         "enter": "outline_panel::Open"
    //     }
    // },
    // normal mode
    {
        "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
        "bindings": {
            "ctrl-l": ["workspace::SendKeystrokes", "ctrl-w l"],
            "ctrl-h": ["workspace::SendKeystrokes", "ctrl-w h"],
            "ctrl-k": ["workspace::SendKeystrokes", "ctrl-w k"],
            "ctrl-j": ["workspace::SendKeystrokes", "ctrl-w j"],
            "ctrl-w t": "terminal_panel::ToggleFocus",
            "ctrl-w p": "workspace::ToggleLeftDock",
            "ctrl-w o": "workspace::ToggleRightDock",
            "ctrl-w ctrl-]": "editor::GoToDefinitionSplit",
            "ctrl-shift-e": "pane::RevealInProjectPanel",
            "ctrl-e": "project_panel::ToggleFocus",
            "] g": "editor::GoToDiagnostic",
            "[ g": "editor::GoToPreviousDiagnostic",
            "] h": "editor::GoToHunk",
            "[ h": "editor::GoToPreviousHunk",
            "g r": "editor::FindAllReferences",
            "g y": "editor::GoToTypeDefinition",
            "shift-k": "editor::Hover",
            "space l a": "editor::ToggleCodeActions",
            "space l r": "editor::Rename",
            "space l R": "editor::RestartLanguageServer",
            "space l D": "dev::OpenLanguageServerLogs",
            "space =": "editor::Format",
            "space l l": "diagnostics::Deploy",
            "space w": "workspace::Save",
            "space q": "pane::CloseAllItems",
            "space f t": "project_symbols::Toggle",
            "space f s": "outline::Toggle",
            "space f p": "projects::OpenRecent",
            "space t s": "task::Spawn",
            "space t r": "task::Rerun",
            "space g c": "git::Commit",
            "space g b": "git::Branch",
            "space g h d": "editor::ToggleSelectedDiffHunks",
            "space g h r": "git::Restore",
            "space g h R": "git::RestoreFile",
            "space g h D": "editor::ExpandAllDiffHunks",
            "space o": "tab_switcher::ToggleAll"
        }
    },
    // this breaks the ya[ operator for some reason
    // {
    //     "context": "vim_operator == y && !VimWaiting",
    //     "bindings": {
    //       "a a": "assistant::CopyCode",
    //     }
    // },
    // insert mode
    {
        "context": "Editor && vim_mode == insert && !menu",
        "bindings": {
            "ctrl-space": "editor::ShowCompletions"
        }
    },
    // these will happen even in the menu
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            "ctrl-e": "editor::MoveToEndOfLine",
            "ctrl-a": "editor::MoveToBeginningOfLine",
            "ctrl-b": "editor::MoveLeft",
            "ctrl-f": "editor::MoveRight",
        }
    },
    // {
    //     "context": "Editor && mode == full",
    //     "bindings": {
    //         "ctrl-enter": "editor::OpenExcerpts"
    //     }
    // },
    {
        "context": "BufferSearchBar",
        "bindings": {
            "ctrl-[": "buffer_search::Dismiss"
        }
    },
    // File panel (netrw)
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "ctrl-e": "project_panel::ToggleFocus",
            "a": "project_panel::NewFile",
            "A": "project_panel::NewDirectory",
            "r": "project_panel::Rename",
            "d": "project_panel::Delete",
            "x": "project_panel::Cut",
            "c": "project_panel::Copy",
            "p": "project_panel::Paste",
            // Close project panel as project file panel on the right
            "q": "workspace::ToggleRightDock",
            "space e": "workspace::ToggleRightDock",
            // Navigate between panel
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-l": "workspace::ActivatePaneRight",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-j": "workspace::ActivatePaneDown"
        }
    },
]