// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    // "inline_completions": {},
    // "show_inline_completions": false,
    // "show_edit_predictions": false,
    // "features": {
    //     "edit_prediction_provider": "supermaven"
    // },
    "base_keymap": "VSCode",
    "features": {
        "edit_prediction_provider": "zed"
        // "edit_prediction_provider": "supermaven"
    },
    "show_edit_predictions": true,
    "edit_predictions": {
        "disabled_globs": [],
        "mode": "subtle",
    },
    "assistant": {
        "always_allow_tool_actions": true,
        "inline_assistant_model": {
            "provider": "zed.dev",
            "model": "claude-3-5-sonnet-latest"
        },
        "default_profile": "write",
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-3-7-sonnet-latest"
        },
        "version": "2",
        "enabled": true,
        // "default_model": {
        //     "provider": "lmstudio",
        //     "model": "deepseek-r1-distill-qwen-7b"
        // }
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "show_background": false,
        "edit_debounce_ms": 700,
        "scroll_debounce_ms": 50
    },
    "theme": "Gruvbox Material Dark",
    "format_on_save": "off",
    // "soft_wrap": "editor_width",
    "ensure_final_newline_on_save": false,
    "remove_trailing_whitespace_on_save": false,
    // never show whitespace indicators
    "show_whitespaces": "none",
    // disable cursor blink
    "cursor_blink": false,
    "current_line_highlight": "none",
    // use relative line numbers
    "relative_line_numbers": true,
    // hide the scroll bar
    "scrollbar": {
        "show": "never"
    },
    // "theme": "Github Dark",
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "always"
    },
    "terminal": {
        "shell": {
            "program": "fish"
        },
        "detect_venv": {
            "on": {
                "activate_script": "fish"
            }
        },
        "env": {
            "EDITOR": "zed --wait"
        }
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    // "ui_font_size": null,
    // "buffer_font_size": 15.0,
    "buffer_line_height": "standard",
    // "buffer_line_heigh6": "comfortable",
    // "Zed Mono": "Cascadia Code",
    // "buffer_font_family": "Fira Code Retina",
    "buffer_font_family": "Cascadia Code",
    "ui_font_family": "Cascadia Code",
    // "ui_font_family": "Zed Mono",
    // "ui_font_family": "Fira Code Retina",
    // "buffer_font_family": "Zed Mono",
    "project_panel": {
        "folder_icons": true,
        "indent_size": 10,
        "indent_guides": {
            "show": "never"
        }
    },
    "outline_panel": {
        "indent_guides": {
            "show": "never"
        },
    },
    "tab_size": 4,
    "file_types": {
        "OCaml": ["mlx"]
    },
    "languages": {
        "Dune": {
            "tab_size": 1
        },
        "Python": {
            "language_servers": ["pyright", "ruff"],
            "formatter": [
                {
                    "language_server": {
                        "name": "ruff"
                    }
                }
            ]
        },
        "Haskell": {
            "language_servers": ["hls", "!static-ls", "..."],
            "tab_size": 2
        },
        "OCaml": {
            "tab_size": 2
        },
        "OCaml Interface": {
            "tab_size": 2
        },
        "Zig": {
            "format_on_save": "on",
            "code_actions_on_format": {
                "source.fixAll": false
            }
        },
        "TSX": {
            "tab_size": 2,
            "inlay_hints": {
                "enabled": false
            }
        },
        "TypeScript": {
            "tab_size": 2,
            "inlay_hints": {
                "enabled": false
            }
        },
        "JavaScript": {
            "tab_size": 2,
            "JavaScript": {
                "formatter": {
                    "external": {
                        "command": "prettierd",
                        "arguments": ["--stdin-filepath", "{buffer_path}"]
                    }
                }
            }
        }
    },
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false,
    },
    "toolbar": {
        "quick_actions": false,
        "breadcrumbs": false
    },
    "indent_guides": {
        "enabled": false
    },
    "lsp": {
        "pyright": {
            "settings": {
                "python": {
                    "pythonPath": ".venv/bin/python"
                }
            }
        },
        "zls": {
            "binary": {
                "path": "/home/brian/projects/zls/zig-out/bin/zls"
            },
            "initialization_options": {
                // "enable_build_on_save": true
            }
        },
        "hls": {
            "initialization_options": {
                "haskell": {
                    "formattingProvider": "ormolu",
                    "plugin": {
                        "hlint": {
                            "globalOn": false
                        }
                    }
                }
            }
        }
    }
}
