{
    "layer": "top",
    "modules-left": [
        "custom/launcher",
        "backlight",
        "wireplumber",
        "power-profiles-daemon",
        "mpris",
    ],
    "modules-center": ["niri/workspaces"],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "battery",
        "clock",
        "custom/powermenu",
    ],

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "▶",
            "mpv": "🎵",
        },
        "status-icons": {
            "paused": "⏸",
        },
        "max-length": 30,
        // "ignored-players": ["firefox"]
    },

    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {
            "blueman": "bluetooth",
            "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png",
        },
    },

    "power-profiles-daemon": {
        "format": "{icon}  {profile}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": "",
        },
    },

    "wlr/taskbar": {
        "format": "{name}",
        "on-click": "activate",
        "rewrite": {
            "Google Chrome": "Chrome",
            "Zed Editor": "Zed",
        },
    },

    "wireplumber": {
        "tooltip": false,
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "on-click": "pavucontrol",
        "format-icons": {
            "default": ["", "", ""],
        },
    },

    "network": {
        "tooltip": false,
        "format-wifi": "  {essid}",
        "format-disconnected": "󱚵 disconnected",
        "format-ethernet": "󰈀 ethernet",
        "format-disabled": "disabled",
        "on-click": "alacritty --command nmtui",
    },

    "backlight": {
        "tooltip": false,
        "format": " {}%",
        "interval": 1,
        "on-scroll-up": "light -A 5",
        "on-scroll-down": "light -U 5",
    },

    "battery": {
        "states": {
            "full": 100,
            "good": 95,
            "decent": 50,
            "warning": 30,
            "critical": 20,
        },
        "format": "{icon}  {capacity}%",
        "format-time": "{H} h {M} min",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""],
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%m-%d-%Y}",
    },

    "cpu": {
        "interval": 15,
        "format": "  {}%",
        "max-length": 10,
        "on-click": "alacritty --command btm",
    },

    "memory": {
        "interval": 30,
        "format": "  {}%",
        "max-length": 10,
    },

    "custom/media": {
        "interval": 30,
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 20,
        "format-icons": {
            "spotify": " ",
            "default": " ",
        },
        "escape": true,
        "exec": "$HOME/.config/system_scripts/mediaplayer.py 2> /dev/null",
        "on-click": "playerctl play-pause",
    },

    "custom/launcher": {
        "format": " ",
        "on-click": "tofi-drun --drun-launch=true",
    },

    "custom/powermenu": {
        "format": " ",
        "on-click": "$HOME/.local/share/bin/tofi_power_menu.py",
    },

    "niri/workspaces": {
        "format": "{icon}  ({index})",
        "on-click": "activate",
        "format-icons": {
            "code 1": "",
            "code 2": "",
            "browser": "",
            "cp": "",
            "learning": "",
            "chat": "",
            "music": "",
        },
        "active": "",
        "sort-by-number": true,
        "max-length": 2,
    },
}
